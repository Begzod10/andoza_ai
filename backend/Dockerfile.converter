# Converter service image: the app's Python deps + headless Blender, for the
# USDZ→GLB Celery task on the `converter` queue. Kept separate from the API/worker
# image so those stay slim (Blender + GL libs are large).
#
# Blender comes from the official blender.org tarball, NOT from Debian apt.
# Debian's `blender` package is built without USD support, so `bpy.ops.wm.usd_import`
# simply does not exist there and every USDZ conversion died with
#   AttributeError: Calling operator "bpy.ops.wm.usd_import" error, could not be found
# The official builds ship OpenUSD, so the importer is present.
#
# blender.org publishes Linux builds for x86-64 only (no linux-arm64), hence the
# pinned platform — on an arm64 host this builds/runs under emulation.
FROM --platform=linux/amd64 python:3.12-slim

# GL/X/audio runtime libs headless Blender still dlopens. xvfb is kept as a
# fallback if a future Blender build insists on a display (`xvfb-run -a blender ...`).
RUN apt-get update && apt-get install -y --no-install-recommends \
        xvfb \
        libgl1 \
        libglu1-mesa \
        libegl1 \
        libx11-6 \
        libxi6 \
        libxext6 \
        libxrender1 \
        libxfixes3 \
        libxxf86vm1 \
        libxcursor1 \
        libxinerama1 \
        libxrandr2 \
        libxkbcommon0 \
        libsm6 \
        libice6 \
        libwayland-client0 \
        libdbus-1-3 \
        libtinfo6 \
        curl \
        xz-utils \
    && rm -rf /var/lib/apt/lists/*

# Pinned Blender LTS. Bump both the version and the checksum together.
ARG BLENDER_VERSION=4.5.14
ARG BLENDER_SERIES=4.5
ARG BLENDER_SHA256=9ba871ff2ecd36526b77432745980b7e6664ecd0c7ca11c48849073dcfe06da3
RUN set -eux; \
    tarball="blender-${BLENDER_VERSION}-linux-x64.tar.xz"; \
    curl -fsSL -o "/tmp/${tarball}" \
        "https://download.blender.org/release/Blender${BLENDER_SERIES}/${tarball}"; \
    echo "${BLENDER_SHA256}  /tmp/${tarball}" | sha256sum -c -; \
    mkdir -p /opt/blender; \
    tar -xJf "/tmp/${tarball}" -C /opt/blender --strip-components=1; \
    rm -f "/tmp/${tarball}"; \
    # Trim ballast we never touch in a headless import/export run.
    rm -rf /opt/blender/${BLENDER_SERIES}/datafiles/studiolights/world \
           /opt/blender/${BLENDER_SERIES}/scripts/addons_core/cycles/lib; \
    ln -s /opt/blender/blender /usr/local/bin/blender; \
    blender --version

WORKDIR /app
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY . .

ENV PYTHONPATH=/app \
    BLENDER_BIN=blender

# Only consumes the `converter` queue (the plain worker handles default,media).
CMD ["celery", "-A", "celery_app", "worker", "-l", "info", "-Q", "converter", "-c", "2"]
