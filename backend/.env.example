# ============================================================
# AndozaAI Backend – Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ------------------------------------------------------------------
# Application
# ------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Comma-separated list of allowed CORS origins (web app origins).
# The native mobile app's WebView origins (capacitor://localhost, http://localhost)
# are ALWAYS allowed in code (see config.py CORS_ORIGINS) — no need to list them here.
CORS_ORIGINS_STR=http://localhost:3000,http://localhost:5173

# ------------------------------------------------------------------
# Database (PostgreSQL)
# Default matches docker-compose (service host "postgres", db "uytamir").
# For running the backend directly on your machine use e.g.:
#   DATABASE_URL=postgresql+asyncpg://uytamir:password@localhost:5432/uytamir_db
# ------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://uytamir:password@postgres:5432/uytamir

# ------------------------------------------------------------------
# Redis
# Default matches docker-compose (service host "redis").
# For running the backend directly on your machine use:
#   REDIS_URL=redis://localhost:6379/0
# ------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------------
# S3-compatible Object Storage
# ------------------------------------------------------------------
S3_BUCKET=andoza-ai-media
S3_REGION=us-east-1
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
# Leave blank to use AWS S3; set to e.g. https://s3.uz for local/minio
S3_ENDPOINT_URL=

# ------------------------------------------------------------------
# SMS Gateway
# Supported: eskiz | playmobile
# ------------------------------------------------------------------
SMS_PROVIDER=eskiz
SMS_SENDER_ID=AndozaAI

# Eskiz credentials
ESKIZ_EMAIL=you@example.com
ESKIZ_PASSWORD=your-eskiz-password

# Playmobile credentials (used when SMS_PROVIDER=playmobile)
PLAYMOBILE_URL=https://send.smsxabar.uz/broker-api/send
PLAYMOBILE_LOGIN=your-login
PLAYMOBILE_PASSWORD=your-password

# ------------------------------------------------------------------
# Sentry (optional – leave blank to disable)
# ------------------------------------------------------------------
SENTRY_DSN=

# ------------------------------------------------------------------
# AI Features
# Set AI_FEATURES_ENABLED=true and provide OPENAI_API_KEY to enable.
# Any OpenAI-compatible provider works via OPENAI_BASE_URL:
#   OpenAI (default):  leave OPENAI_BASE_URL empty, key sk-..., models gpt-*
#   Google Gemini:     OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#                      key AQ.... yoki AIza..., models gemini-2.5-flash / gemini-2.5-pro
# ------------------------------------------------------------------
AI_FEATURES_ENABLED=true
AI_MODEL_BUILDER=gpt-4-turbo
AI_MODEL_EXPLAINER=gpt-4-mini
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
OPENAI_BASE_URL=

# ------------------------------------------------------------------
# MyArchitectAI (photorealistic renders of a studio screenshot)
# Get an API key from https://portal.myarchitectai.com/
# Every render is billed to this one key; RENDER_DAILY_LIMIT caps each
# user's renders per day (0 turns the feature off).
# ------------------------------------------------------------------
MYARCHITECT_API_KEY=
MYARCHITECT_API_URL=https://api.myarchitectai.com/v1
RENDER_DAILY_LIMIT=10

# ------------------------------------------------------------------
# Tripo (3D model from a photo — the studio's "Rasmdan 3D model" button)
# Get an API key and buy credits at https://platform.tripo3d.ai/
# Pay as you go: 1 credit = $0.01, a textured model is ~30 credits.
# MODEL_FROM_PHOTO_DAILY_LIMIT caps each user's models per day (0 = off).
# ------------------------------------------------------------------
TRIPO_API_KEY=
TRIPO_API_URL=https://openapi.tripo3d.ai/v3
TRIPO_MODEL=v3.1-20260211
MODEL_FROM_PHOTO_DAILY_LIMIT=3
