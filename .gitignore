# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/
frontend/node_modules/

# ── Build output ──────────────────────────────────────────────────────────────
frontend/dist/
frontend/.vite/
dist/
.next/

# ── Environment / secrets ─────────────────────────────────────────────────────
.env
.env.local
backend/.env
backend/.env.local
frontend/.env
frontend/.env.local

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.venv/
venv/
backend/.venv/
*.egg-info/
.pytest_cache/

# ── Alembic ───────────────────────────────────────────────────────────────────
alembic/versions/*.pyc
alembic/versions/

# ── Database / media ──────────────────────────────────────────────────────────
*.db
*.sqlite3
media/
# …except the user-imported 3D models: the user wants those versioned in the
# repo, not only in media storage. Re-include the parent, ignore its other
# children, then re-include models/ (gitignore can't re-include inside an
# excluded directory, hence the three-step dance).
!backend/media/
backend/media/*
!backend/media/models/
uploads/

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log

# ── Playwright / testing ──────────────────────────────────────────────────────
.playwright-mcp/

# ── Claude session files ──────────────────────────────────────────────────────
.claude/*
# ...but keep shared skills checked in
!.claude/skills/

# ── IDE ───────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Misc ──────────────────────────────────────────────────────────────────────
.git
structure
test_main.http
