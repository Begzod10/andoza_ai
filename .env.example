# Copy to .env to switch local dev's frontend to the PRODUCTION backend
# (and its database) instead of the local docker backend+postgres.
#
# VITE_API_URL must stay a relative path here (not a full
# https://andoza.jumaniyozov.uz/... URL) so requests stay same-origin from
# the browser's point of view and go through the vite dev-server proxy
# (frontend/vite.config.ts) instead of hitting prod directly. This is
# required because the backend's auth cookies are SameSite=Lax and are never
# sent on a genuinely cross-origin fetch() from localhost to the prod
# domain — only proxied, same-origin requests carry them correctly.
#
# Leave this file absent (the default) to use the local backend at
# localhost:8000, as docker-compose.yml's own defaults do.
VITE_API_URL=/api/v1
VITE_API_PROXY_TARGET=https://andoza.jumaniyozov.uz
